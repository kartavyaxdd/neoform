{
  "name": "neoform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neoform",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REST_ALERTS",
        "class_name": "RestAlertDevice"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rest-alerts-v1",
      "new_sqlite_classes": [
        "RestAlertDevice"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
